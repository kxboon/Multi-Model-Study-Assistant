# Copy this file to .env and adjust values for your local setup.
# The application reads these at startup via python-dotenv.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# Every value below has a working default in code, so an empty .env still runs.

# --- Whisper ---
# Supported sizes: tiny, base, small, medium, large
# "base" is recommended for experimentation (~74 MB, runs on CPU)
WHISPER_MODEL_SIZE=base

# --- Ollama ---
# The model tag that Ollama has pulled locally (ollama pull llama3.2)
OLLAMA_MODEL=llama3.2

# Base URL of the Ollama REST server.
# Prefer 127.0.0.1 over localhost. On some Windows machines "localhost"
# resolves to ::1 first, and because Ollama listens on IPv4 only, every
# request waits for the IPv6 attempt to fail before falling back --
# roughly a 2 second penalty on every call.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- ChromaDB ---
# Where ChromaDB persists its index between runs.
# Relative paths are resolved against the project root by backend/paths.py,
# not against the current working directory, so the store stays the same
# whether you launch uvicorn from the root or from inside backend/.
CHROMA_PATH=./vectorstore/chroma_db

# --- Model cache ---
# Directory for HuggingFace / sentence-transformers weights, so they are not
# re-downloaded after recreating the venv.
MODELS_CACHE=./models_cache

# --- Learning signals ---
# Where the learning-signal log is written (quiz results, flashcard ratings,
# question sentiment). Optional -- defaults to ./signals.json when unset.
# SIGNALS_PATH=./signals.json
